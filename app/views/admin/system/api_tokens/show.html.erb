<% content_for :title, @api_token.name.presence || 'API Token' %>

<div class="max-w-4xl mx-auto space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-white"><%= @api_token.name.presence || 'API Token' %></h1>
      <p class="text-gray-400">Role: <%= @api_token.role %></p>
    </div>
    <div class="flex items-center gap-2">
      <%= link_to edit_admin_system_api_token_path(@api_token), class: "px-3 py-2 bg-gray-700 hover:bg-gray-600 text-white text-sm rounded-lg" do %>
        Edit
      <% end %>
      <%= link_to regenerate_admin_system_api_token_path(@api_token), method: :post, data: { confirm: 'Regenerate token value?' }, class: "px-3 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-sm rounded-lg" do %>
        Regenerate
      <% end %>
      <%= link_to admin_system_api_token_path(@api_token), method: :delete, data: { confirm: 'Delete this token?' }, class: "px-3 py-2 bg-red-600 hover:bg-red-700 text-white text-sm rounded-lg" do %>
        Delete
      <% end %>
    </div>
  </div>

  <div class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-xl p-6">
    <h3 class="text-lg font-semibold text-white mb-4">Details</h3>
    <div class="space-y-3">
      <div class="flex justify-between"><span class="text-gray-400">Token:</span><span class="text-white font-mono text-sm"><%= @api_token.token %></span></div>
      <div class="flex justify-between"><span class="text-gray-400">Active:</span><span class="text-white"><%= @api_token.active? ? 'Yes' : 'No' %></span></div>
      <div class="flex justify-between"><span class="text-gray-400">Expires At:</span><span class="text-white"><%= @api_token.expires_at ? l(@api_token.expires_at) : 'Never' %></span></div>
      <% if @api_token.permissions.present? %>
        <div>
          <span class="block text-gray-400 mb-1">Permissions</span>
          <pre class="bg-[#0a0a0a] border border-[#2a2a2a] text-white rounded-lg p-3 text-xs overflow-auto"><%= @api_token.permissions %></pre>
        </div>
      <% end %>
    </div>
  </div>

  <div>
    <%= link_to admin_system_api_tokens_path, class: "text-sm text-gray-400 hover:text-white" do %>
      ← Back to tokens
    <% end %>
  </div>
</div>


