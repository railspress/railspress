<div class="space-y-6">
  <div>
    <h3 class="text-sm font-semibold" style="color: var(--admin-text-secondary);">Page</h3>
    <div class="mt-3 space-y-3">
      <div>
        <%= f.label :slug, "URL Slug", class: "block text-xs", style: "color: var(--admin-text-tertiary);" %>
        <div class="flex items-center gap-2">
          <span class="text-gray-500 text-sm">/</span>
          <%= f.text_field :slug, class: "w-full px-3 py-2 rounded-lg", style: "background-color: var(--admin-bg-secondary); color: var(--admin-text-primary); border: 1px solid var(--admin-border);" %>
        </div>
      </div>

      <div>
        <%= f.label :status, "Status", class: "block text-xs", style: "color: var(--admin-text-tertiary);" %>
        <%= f.select :status, options_for_select(Page.statuses.keys.map { |s| [s.humanize, s] }, @page.status || 'draft'), {}, class: "w-full px-3 py-2 rounded-lg", style: "background-color: var(--admin-bg-secondary); color: var(--admin-text-primary); border: 1px solid var(--admin-border);" %>
      </div>

      <div>
        <%= f.label :published_at, "Publish Date & Time", class: "block text-xs", style: "color: var(--admin-text-tertiary);" %>
        <%= f.datetime_local_field :published_at, class: "w-full px-3 py-2 rounded-lg", style: "background-color: var(--admin-bg-secondary); color: var(--admin-text-primary); border: 1px solid var(--admin-border);" %>
      </div>

      <div>
        <%= f.label :parent_id, "Parent Page", class: "block text-xs", style: "color: var(--admin-text-tertiary);" %>
        <%= f.select :parent_id, options_for_select([["None (Top Level)", nil]] + Page.where.not(id: @page.id).order(:title).map { |p| [p.title, p.id] }, @page.parent_id), {}, class: "w-full px-3 py-2 rounded-lg", style: "background-color: var(--admin-bg-secondary); color: var(--admin-text-primary); border: 1px solid var(--admin-border);" %>
      </div>

      <div>
        <%= f.label :order, "Order", class: "block text-xs", style: "color: var(--admin-text-tertiary);" %>
        <%= f.number_field :order, class: "w-full px-3 py-2 rounded-lg", style: "background-color: var(--admin-bg-secondary); color: var(--admin-text-primary); border: 1px solid var(--admin-border);" %>
      </div>

      <div>
        <%= f.label :page_template_id, "Template", class: "block text-xs", style: "color: var(--admin-text-tertiary);" %>
        <%= f.collection_select :page_template_id, PageTemplate.active.order(:name), :id, :name, { include_blank: "Default" }, class: "w-full px-3 py-2 rounded-lg", style: "background-color: var(--admin-bg-secondary); color: var(--admin-text-primary); border: 1px solid var(--admin-border);" %>
      </div>

      <div>
        <%= f.label :password, "Password (optional)", class: "block text-xs", style: "color: var(--admin-text-tertiary);" %>
        <%= f.password_field :password, class: "w-full px-3 py-2 rounded-lg", style: "background-color: var(--admin-bg-secondary); color: var(--admin-text-primary); border: 1px solid var(--admin-border);" %>
      </div>

      <div>
        <%= f.label :password_hint, "Password Hint", class: "block text-xs", style: "color: var(--admin-text-tertiary);" %>
        <%= f.text_field :password_hint, class: "w-full px-3 py-2 rounded-lg", style: "background-color: var(--admin-bg-secondary); color: var(--admin-text-primary); border: 1px solid var(--admin-border);" %>
      </div>

      <div>
        <%= f.label :channel_ids, "Channels", class: "block text-xs", style: "color: var(--admin-text-tertiary);" %>
        <%= f.collection_select :channel_ids, (@channels || Channel.active.order(:name)), :id, :name, { include_hidden: false }, { multiple: true, class: "w-full px-3 py-2 rounded-lg", style: "background-color: var(--admin-bg-secondary); color: var(--admin-text-primary); border: 1px solid var(--admin-border);" } %>
      </div>
    </div>
  </div>
</div>


