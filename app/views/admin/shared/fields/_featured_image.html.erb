<div data-controller="featured-image"
     data-featured-image-dialog-id-value="featured-image-selector">
  
  <!-- Current preview -->
  <div class="featured-image-preview" data-featured-image-target="preview">
    <% if record.featured_medium&.url.present? %>
      <%= image_tag record.featured_medium.url, class: "w-full h-full object-cover" %>
      <div class="featured-image-overlay">
        <button type="button" class="featured-image-btn featured-image-btn-replace" data-action="click->featured-image#openMediaSelector">Replace</button>
        <button type="button" class="featured-image-btn featured-image-btn-remove" data-action="click->featured-image#removeImage">Remove</button>
      </div>
    <% elsif record.featured_image_file.attached? %>
      <%= image_tag record.featured_image_file, class: "w-full h-full object-cover" %>
      <div class="featured-image-overlay">
        <button type="button" class="featured-image-btn featured-image-btn-replace" data-action="click->featured-image#openMediaSelector">Replace</button>
        <button type="button" class="featured-image-btn featured-image-btn-remove" data-action="click->featured-image#removeImage">Remove</button>
      </div>
    <% else %>
      <div class="featured-image-upload-placeholder" data-action="click->featured-image#openMediaSelector">
        Click to upload featured image
      </div>
    <% end %>
  </div>
  
  <%= f.hidden_field :featured_medium_id, value: record.featured_medium_id, data: { featured_image_target: "hiddenField" } %>
  
  <!-- Media Selector Dialog -->
  <%= render 'admin/shared/media_selector_dialog',
      dialog_id: 'featured-image-selector',
      dialog_title: 'Featured image',
      button_text: 'Set featured image',
      on_select_callback: 'handleFeaturedImageSelected',
      allow_multi_select: false %>
</div>
