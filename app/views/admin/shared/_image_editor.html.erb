<% 
  # Theme defaults using CSS variables
  theme = {
    bg_color: 'var(--admin-bg-app)',
    text_color: 'var(--admin-text-primary)',
    border_color: 'var(--admin-border)',
    button_bg: 'var(--admin-primary)',
    button_hover_bg: 'var(--admin-primary-hover)',
    button_text: 'white',
    secondary_bg: 'var(--admin-bg-secondary)',
    toolbar_bg: 'var(--admin-bg-elevated)',
    input_bg: 'var(--admin-bg-primary)'
  }.merge(local_assigns[:theme] || {})

  editor_id = local_assigns[:editor_id] || 'image-editor'
%>

<!-- Image Editor Overlay -->
<div id="<%= editor_id %>"
     data-controller="image-editor image-zoom"
     data-image-editor-target="overlay"
     class="hidden fixed inset-0 z-[10000]"
     style="background: rgba(0, 0, 0, 0.95);">
  
  <!-- Header -->
  <div class="flex items-center justify-between px-6 py-4 border-b"
       style="border-color: <%= theme[:border_color] %>; background: <%= theme[:bg_color] %>;">
    <h2 class="text-lg font-semibold" style="color: <%= theme[:text_color] %>;">
      Edit Image
    </h2>
    
    <!-- Zoom Controls - CENTER -->
    <div class="zoom-control-container">
      <div class="zoom-control-pill">
        <button type="button" class="zoom-btn-minus" data-action="click->image-zoom#zoomOut">−</button>
        <button type="button" class="zoom-display" data-action="click->image-zoom#toggleZoomDropdown">
          <span data-image-zoom-target="zoomPercentage">100%</span>
        </button>
        <button type="button" class="zoom-btn-plus" data-action="click->image-zoom#zoomIn">+</button>
      </div>
      
      <div class="zoom-dropdown hidden" data-image-zoom-target="zoomDropdown">
        <div class="zoom-option" data-action="click->image-zoom#selectZoomLevel" data-zoom="25">25%</div>
        <div class="zoom-option" data-action="click->image-zoom#selectZoomLevel" data-zoom="50">50%</div>
        <div class="zoom-option active" data-action="click->image-zoom#selectZoomLevel" data-zoom="100">
          100% <span class="zoom-label">Actual size</span>
        </div>
        <div class="zoom-option" data-action="click->image-zoom#selectZoomLevel" data-zoom="125">125%</div>
        <div class="zoom-option" data-action="click->image-zoom#selectZoomLevel" data-zoom="150">150%</div>
        <div class="zoom-option" data-action="click->image-zoom#selectZoomLevel" data-zoom="200">200%</div>
        <div class="zoom-option" data-action="click->image-zoom#selectZoomLevel" data-zoom="300">300%</div>
        <div class="zoom-option" data-action="click->image-zoom#selectZoomLevel" data-zoom="400">400%</div>
        <div class="zoom-option" data-action="click->image-zoom#selectZoomLevel" data-zoom="600">600%</div>
        <div class="zoom-option" data-action="click->image-zoom#selectZoomLevel" data-zoom="800">800%</div>
        <div class="zoom-option" data-action="click->image-zoom#selectZoomLevel" data-zoom="1600">1600%</div>
      </div>
    </div>
    
    <div class="flex items-center gap-2">
      <!-- Undo -->
      <button type="button"
              data-action="click->image-editor#undo"
              data-image-editor-target="undoBtn"
              disabled
              class="px-3 py-1.5 rounded text-sm disabled:opacity-50"
              style="background: <%= theme[:secondary_bg] %>; color: <%= theme[:text_color] %>;">
        Undo
      </button>
      <!-- Redo -->
      <button type="button"
              data-action="click->image-editor#redo"
              data-image-editor-target="redoBtn"
              disabled
              class="px-3 py-1.5 rounded text-sm disabled:opacity-50"
              style="background: <%= theme[:secondary_bg] %>; color: <%= theme[:text_color] %>;">
        Redo
      </button>
      <!-- Cancel -->
      <button type="button"
              data-action="click->image-editor#cancelEditing"
              class="px-3 py-1.5 rounded text-sm"
              style="background: <%= theme[:secondary_bg] %>; color: <%= theme[:text_color] %>;">
        Cancel
      </button>
      <!-- Save -->
      <button type="button"
              data-action="click->image-editor#saveEdits"
              class="px-4 py-1.5 rounded text-sm font-medium"
              style="background: <%= theme[:button_bg] %>; color: <%= theme[:button_text] %>;">
        Save
      </button>
    </div>
  </div>

  <!-- Main Content -->
  <div class="flex h-[calc(100vh-120px)]">
    
    <!-- Left: Tabs -->
    <div class="w-48 border-r p-4"
         style="border-color: <%= theme[:border_color] %>; background: <%= theme[:bg_color] %>;">
      <div class="space-y-2">
        <button type="button"
                data-action="click->image-editor#switchTab"
                data-tab="filters"
                data-image-editor-target="tabBtn"
                class="w-full text-left px-4 py-2 rounded text-sm font-medium tab-btn-active"
                style="background: <%= theme[:button_bg] %>; color: <%= theme[:button_text] %>;">
          Filters
        </button>
        <button type="button"
                data-action="click->image-editor#switchTab"
                data-tab="crop"
                data-image-editor-target="tabBtn"
                class="w-full text-left px-4 py-2 rounded text-sm"
                style="color: <%= theme[:text_color] %>;">
          Crop
        </button>
        <button type="button"
                data-action="click->image-editor#switchTab"
                data-tab="scale"
                data-image-editor-target="tabBtn"
                class="w-full text-left px-4 py-2 rounded text-sm"
                style="color: <%= theme[:text_color] %>;">
          Scale
        </button>
        <button type="button"
                data-action="click->image-editor#switchTab"
                data-tab="rotation"
                data-image-editor-target="tabBtn"
                class="w-full text-left px-4 py-2 rounded text-sm"
                style="color: <%= theme[:text_color] %>;">
          Rotation
        </button>
        <button type="button"
                data-action="click->image-editor#switchTab"
                data-tab="advanced"
                data-image-editor-target="tabBtn"
                class="w-full text-left px-4 py-2 rounded text-sm"
                style="color: <%= theme[:text_color] %>;">
          Advanced
        </button>
      </div>
    </div>

    <!-- Center: Canvas/Preview -->
    <div class="flex-1 flex items-center justify-center p-8 overflow-hidden"
         style="background: <%= theme[:secondary_bg] %>;">
      <!-- Virtual Image Display -->
      <div class="relative max-w-full overflow-hidden canvas-checkerboard-container" style="max-height: calc(100vh - 200px);">
        <div data-image-zoom-target="canvasWrapper" style="transform-origin: 0 0;">
          <canvas data-image-editor-target="virtualCanvas"
                  class="shadow-xl"
                  style="max-width: 100%; max-height: calc(100vh - 200px); display: block; object-fit: contain;"></canvas>
        </div>
      </div>
    </div>

    <!-- Right: Tab Content Panels -->
    <div class="w-80 border-l overflow-y-auto"
         style="border-color: <%= theme[:border_color] %>; background: <%= theme[:bg_color] %>;">
      
      <!-- FILTERS TAB -->
      <div data-image-editor-target="filtersPanel" class="p-6">
        <h3 class="text-sm font-semibold mb-4" style="color: <%= theme[:text_color] %>;">
          Choose Filter
        </h3>
        <div class="grid grid-cols-2 gap-3" data-image-editor-target="filterGrid">
          <!-- Filter thumbnails will be dynamically generated -->
        </div>
      </div>

      <!-- CROP TAB -->
      <div data-image-editor-target="cropPanel" class="p-6 hidden">
        <h3 class="text-sm font-semibold mb-4" style="color: <%= theme[:text_color] %>;">
          Crop Image
        </h3>
        <div class="space-y-4">
          <div>
            <label class="block text-xs mb-2" style="color: <%= theme[:text_color] %>;">
              Aspect Ratio
            </label>
            <select data-image-editor-target="aspectRatio"
                    data-action="change->image-editor#changeAspectRatio"
                    class="w-full px-3 py-2 rounded text-sm"
                    style="background: <%= theme[:input_bg] %>; color: <%= theme[:text_color] %>; border: 1px solid <%= theme[:border_color] %>;">
              <option value="free">Free</option>
              <option value="1">1:1 (Square)</option>
              <option value="1.3333333333333333">4:3</option>
              <option value="1.7777777777777777">16:9</option>
              <option value="0.75">3:4 (Portrait)</option>
              <option value="0.5625">9:16 (Story)</option>
            </select>
          </div>
          <button type="button"
                  data-action="click->image-editor#applyCrop"
                  class="w-full px-4 py-2 rounded text-sm font-medium"
                  style="background: <%= theme[:button_bg] %>; color: <%= theme[:button_text] %>;">
            Apply Crop
          </button>
        </div>
      </div>

      <!-- SCALE TAB -->
      <div data-image-editor-target="scalePanel" class="p-6 hidden">
        <h3 class="text-sm font-semibold mb-4" style="color: <%= theme[:text_color] %>;">
          Scale Image
        </h3>
        <div class="space-y-4">
          <div>
            <label class="block text-xs mb-2" style="color: <%= theme[:text_color] %>;">
              Width
            </label>
            <input type="number"
                   data-image-editor-target="scaleWidth"
                   data-action="input->image-editor#updateScaleHeight"
                   class="w-full px-3 py-2 rounded text-sm"
                   style="background: <%= theme[:input_bg] %>; color: <%= theme[:text_color] %>; border: 1px solid <%= theme[:border_color] %>;">
          </div>
          <div>
            <label class="block text-xs mb-2" style="color: <%= theme[:text_color] %>;">
              Height
            </label>
            <input type="number"
                   data-image-editor-target="scaleHeight"
                   data-action="input->image-editor#updateScaleWidth"
                   class="w-full px-3 py-2 rounded text-sm"
                   style="background: <%= theme[:input_bg] %>; color: <%= theme[:text_color] %>; border: 1px solid <%= theme[:border_color] %>;">
          </div>
          <label class="flex items-center gap-2">
            <input type="checkbox"
                   data-image-editor-target="lockAspect"
                   checked
                   class="rounded">
            <span class="text-xs" style="color: <%= theme[:text_color] %>;">
              Lock aspect ratio
            </span>
          </label>
          <button type="button"
                  data-action="click->image-editor#applyScale"
                  class="w-full px-4 py-2 rounded text-sm font-medium"
                  style="background: <%= theme[:button_bg] %>; color: <%= theme[:button_text] %>;">
            Apply Scale
          </button>
        </div>
      </div>

      <!-- ROTATION TAB -->
      <div data-image-editor-target="rotationPanel" class="p-6 hidden">
        <h3 class="text-sm font-semibold mb-4" style="color: <%= theme[:text_color] %>;">
          Rotate & Flip
        </h3>
        <div class="space-y-3">
          <button type="button"
                  data-action="click->image-editor#rotateLeft"
                  class="w-full px-4 py-2 rounded text-sm"
                  style="background: <%= theme[:secondary_bg] %>; color: <%= theme[:text_color] %>;">
            Rotate 90° Left
          </button>
          <button type="button"
                  data-action="click->image-editor#rotateRight"
                  class="w-full px-4 py-2 rounded text-sm"
                  style="background: <%= theme[:secondary_bg] %>; color: <%= theme[:text_color] %>;">
            Rotate 90° Right
          </button>
          <button type="button"
                  data-action="click->image-editor#rotate180"
                  class="w-full px-4 py-2 rounded text-sm"
                  style="background: <%= theme[:secondary_bg] %>; color: <%= theme[:text_color] %>;">
            Rotate 180°
          </button>
          <button type="button"
                  data-action="click->image-editor#flipHorizontal"
                  class="w-full px-4 py-2 rounded text-sm"
                  style="background: <%= theme[:secondary_bg] %>; color: <%= theme[:text_color] %>;">
            Flip Horizontal
          </button>
          <button type="button"
                  data-action="click->image-editor#flipVertical"
                  class="w-full px-4 py-2 rounded text-sm"
                  style="background: <%= theme[:secondary_bg] %>; color: <%= theme[:text_color] %>;">
            Flip Vertical
          </button>
        </div>
      </div>

      <!-- ADVANCED TAB -->
      <div data-image-editor-target="advancedPanel" class="p-6 hidden">
        <h3 class="text-sm font-semibold mb-4" style="color: <%= theme[:text_color] %>;">
          Advanced Adjustments
        </h3>

        <!-- LIGHT SECTION -->
        <div class="image-editor-slider-group mb-4" data-category="light">
          <div class="image-editor-slider-group-header" 
               data-action="click->image-editor#toggleCategory"
               data-category="light"
               style="background: <%= theme[:secondary_bg] %>; border: 1px solid <%= theme[:border_color] %>; cursor: pointer; padding: 0.75rem 1rem; display: flex; justify-content: space-between; align-items: center; border-radius: 6px; margin-bottom: 0.5rem;">
            <span class="text-sm font-medium" style="color: <%= theme[:text_color] %>;">Light</span>
            <svg class="chevron-icon w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: <%= theme[:text_color] %>; transition: transform 0.2s;">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </div>
          <div class="image-editor-slider-content" data-category-content="light" hidden style="padding-left: 0.25rem; padding-right: 0.25rem;">
            <!-- Exposure -->
            <div class="image-editor-slider-item">
              <label class="image-editor-slider-label">
                <span class="image-editor-slider-name" style="color: <%= theme[:text_color] %>;">Exposure</span>
                <span class="image-editor-slider-value" data-image-editor-target="exposureValue" style="color: <%= theme[:text_color] %>;">0</span>
              </label>
              <input type="range" 
                     data-image-editor-target="exposureSlider"
                     data-action="input->image-editor#updateAdvanced"
                     min="-100" max="100" value="0"
                     class="image-editor-slider">
            </div>
            <!-- Brightness -->
            <div class="image-editor-slider-item">
              <label class="image-editor-slider-label">
                <span class="image-editor-slider-name" style="color: <%= theme[:text_color] %>;">Brightness</span>
                <span class="image-editor-slider-value" data-image-editor-target="brightnessValue" style="color: <%= theme[:text_color] %>;">100%</span>
              </label>
              <input type="range" 
                     data-image-editor-target="brightnessSlider"
                     data-action="input->image-editor#updateAdvanced"
                     min="0" max="200" value="100"
                     class="image-editor-slider">
            </div>
            <!-- Contrast -->
            <div class="image-editor-slider-item">
              <label class="image-editor-slider-label">
                <span class="image-editor-slider-name" style="color: <%= theme[:text_color] %>;">Contrast</span>
                <span class="image-editor-slider-value" data-image-editor-target="contrastValue" style="color: <%= theme[:text_color] %>;">100%</span>
              </label>
              <input type="range" 
                     data-image-editor-target="contrastSlider"
                     data-action="input->image-editor#updateAdvanced"
                     min="0" max="200" value="100"
                     class="image-editor-slider">
            </div>
            <!-- Highlights -->
            <div class="image-editor-slider-item">
              <label class="image-editor-slider-label">
                <span class="image-editor-slider-name" style="color: <%= theme[:text_color] %>;">Highlights</span>
                <span class="image-editor-slider-value" data-image-editor-target="highlightsValue" style="color: <%= theme[:text_color] %>;">100%</span>
              </label>
              <input type="range" 
                     data-image-editor-target="highlightsSlider"
                     data-action="input->image-editor#updateAdvanced"
                     min="0" max="200" value="100"
                     class="image-editor-slider">
            </div>
            <!-- Shadows -->
            <div class="image-editor-slider-item">
              <label class="image-editor-slider-label">
                <span class="image-editor-slider-name" style="color: <%= theme[:text_color] %>;">Shadows</span>
                <span class="image-editor-slider-value" data-image-editor-target="shadowsValue" style="color: <%= theme[:text_color] %>;">100%</span>
              </label>
              <input type="range" 
                     data-image-editor-target="shadowsSlider"
                     data-action="input->image-editor#updateAdvanced"
                     min="0" max="200" value="100"
                     class="image-editor-slider">
            </div>
          </div>
        </div>

        <!-- COLOR SECTION -->
        <div class="image-editor-slider-group mb-4" data-category="color">
          <div class="image-editor-slider-group-header" 
               data-action="click->image-editor#toggleCategory"
               data-category="color"
               style="background: <%= theme[:secondary_bg] %>; border: 1px solid <%= theme[:border_color] %>; cursor: pointer; padding: 0.75rem 1rem; display: flex; justify-content: space-between; align-items: center; border-radius: 6px; margin-bottom: 0.5rem;">
            <span class="text-sm font-medium" style="color: <%= theme[:text_color] %>;">Color</span>
            <svg class="chevron-icon w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: <%= theme[:text_color] %>; transition: transform 0.2s;">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </div>
          <div class="image-editor-slider-content" data-category-content="color" hidden style="padding-left: 0.25rem; padding-right: 0.25rem;">
            <!-- Temperature -->
            <div class="image-editor-slider-item">
              <label class="image-editor-slider-label">
                <span class="image-editor-slider-name" style="color: <%= theme[:text_color] %>;">Temperature</span>
                <span class="image-editor-slider-value" data-image-editor-target="temperatureValue" style="color: <%= theme[:text_color] %>;">0</span>
              </label>
              <input type="range" 
                     data-image-editor-target="temperatureSlider"
                     data-action="input->image-editor#updateAdvanced"
                     min="-100" max="100" value="0"
                     class="image-editor-slider">
            </div>
            <!-- Tint -->
            <div class="image-editor-slider-item">
              <label class="image-editor-slider-label">
                <span class="image-editor-slider-name" style="color: <%= theme[:text_color] %>;">Tint</span>
                <span class="image-editor-slider-value" data-image-editor-target="tintValue" style="color: <%= theme[:text_color] %>;">0</span>
              </label>
              <input type="range" 
                     data-image-editor-target="tintSlider"
                     data-action="input->image-editor#updateAdvanced"
                     min="-100" max="100" value="0"
                     class="image-editor-slider">
            </div>
            <!-- Saturation -->
            <div class="image-editor-slider-item">
              <label class="image-editor-slider-label">
                <span class="image-editor-slider-name" style="color: <%= theme[:text_color] %>;">Saturation</span>
                <span class="image-editor-slider-value" data-image-editor-target="saturationValue" style="color: <%= theme[:text_color] %>;">100%</span>
              </label>
              <input type="range" 
                     data-image-editor-target="saturationSlider"
                     data-action="input->image-editor#updateAdvanced"
                     min="0" max="200" value="100"
                     class="image-editor-slider">
            </div>
            <!-- Hue -->
            <div class="image-editor-slider-item">
              <label class="image-editor-slider-label">
                <span class="image-editor-slider-name" style="color: <%= theme[:text_color] %>;">Hue</span>
                <span class="image-editor-slider-value" data-image-editor-target="hueValue" style="color: <%= theme[:text_color] %>;">0°</span>
              </label>
              <input type="range" 
                     data-image-editor-target="hueSlider"
                     data-action="input->image-editor#updateAdvanced"
                     min="-180" max="180" value="0"
                     class="image-editor-slider">
            </div>
          </div>
        </div>

        <!-- EFFECTS SECTION -->
        <div class="image-editor-slider-group mb-4" data-category="effects">
          <div class="image-editor-slider-group-header" 
               data-action="click->image-editor#toggleCategory"
               data-category="effects"
               style="background: <%= theme[:secondary_bg] %>; border: 1px solid <%= theme[:border_color] %>; cursor: pointer; padding: 0.75rem 1rem; display: flex; justify-content: space-between; align-items: center; border-radius: 6px; margin-bottom: 0.5rem;">
            <span class="text-sm font-medium" style="color: <%= theme[:text_color] %>;">Effects</span>
            <svg class="chevron-icon w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: <%= theme[:text_color] %>; transition: transform 0.2s;">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </div>
          <div class="image-editor-slider-content" data-category-content="effects" hidden style="padding-left: 0.25rem; padding-right: 0.25rem;">
            <!-- Blur -->
            <div class="image-editor-slider-item">
              <label class="image-editor-slider-label">
                <span class="image-editor-slider-name" style="color: <%= theme[:text_color] %>;">Blur</span>
                <span class="image-editor-slider-value" data-image-editor-target="blurValue" style="color: <%= theme[:text_color] %>;">0px</span>
              </label>
              <input type="range" 
                     data-image-editor-target="blurSlider"
                     data-action="input->image-editor#updateAdvanced"
                     min="0" max="10" value="0"
                     class="image-editor-slider">
            </div>
            <!-- Sharpen -->
            <div class="image-editor-slider-item">
              <label class="image-editor-slider-label">
                <span class="image-editor-slider-name" style="color: <%= theme[:text_color] %>;">Sharpen</span>
                <span class="image-editor-slider-value" data-image-editor-target="sharpenValue" style="color: <%= theme[:text_color] %>;">0</span>
              </label>
              <input type="range" 
                     data-image-editor-target="sharpenSlider"
                     data-action="input->image-editor#updateAdvanced"
                     min="0" max="100" value="0"
                     class="image-editor-slider">
            </div>
            <!-- Vignette -->
            <div class="image-editor-slider-item">
              <label class="image-editor-slider-label">
                <span class="image-editor-slider-name" style="color: <%= theme[:text_color] %>;">Vignette</span>
                <span class="image-editor-slider-value" data-image-editor-target="vignetteValue" style="color: <%= theme[:text_color] %>;">0%</span>
              </label>
              <input type="range" 
                     data-image-editor-target="vignetteSlider"
                     data-action="input->image-editor#updateAdvanced"
                     min="0" max="100" value="0"
                     class="image-editor-slider">
            </div>
          </div>
        </div>

        <button type="button"
                data-action="click->image-editor#resetAdvanced"
                class="w-full px-4 py-2 rounded text-sm font-medium"
                style="background: <%= theme[:secondary_bg] %>; color: <%= theme[:text_color] %>; border: 1px solid <%= theme[:border_color] %>;">
          Reset All
        </button>
        </div>
      </div>

    </div>
  </div>
</div>
