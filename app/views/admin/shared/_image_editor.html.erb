<% 
  # Theme defaults using CSS variables
  theme = {
    bg_color: 'var(--admin-bg-app)',
    text_color: 'var(--admin-text-primary)',
    border_color: 'var(--admin-border)',
    button_bg: 'var(--admin-primary)',
    button_hover_bg: 'var(--admin-primary-hover)',
    button_text: 'white',
    secondary_bg: 'var(--admin-bg-elevated)',
    toolbar_bg: 'var(--admin-bg-elevated)',
    input_bg: 'var(--admin-bg-primary)'
  }.merge(local_assigns[:theme] || {})

  editor_id = local_assigns[:editor_id] || 'image-editor'
%>

<!-- piexif for EXIF metadata handling -->
<script src="https://cdn.jsdelivr.net/npm/piexifjs@1.0.6/piexif.min.js"></script>

<!-- Image Editor Overlay -->
<div id="<%= editor_id %>"
     data-controller="image-editor image-zoom"
     data-image-editor-target="overlay"
     data-action="click->image-editor#closeFilterPopover"
     class="hidden fixed inset-0 z-[10000]"
     style="background: rgba(0, 0, 0, 0.95);">
  
  <!-- Header -->
  <div class="flex items-center justify-between px-6 py-4 border-b"
       style="border-color: <%= theme[:border_color] %>; background: <%= theme[:bg_color] %>;">
    <h2 class="text-lg font-semibold" style="color: <%= theme[:text_color] %>;">
      Edit Image
    </h2>
    
    <!-- Zoom Controls - CENTER -->
    <div class="zoom-control-container">
      <div class="zoom-control-pill">
        <button type="button" class="zoom-btn-minus" data-action="click->image-zoom#zoomOut">−</button>
        <button type="button" class="zoom-display" data-action="click->image-zoom#toggleZoomDropdown">
          <span data-image-zoom-target="zoomPercentage">100%</span>
        </button>
        <button type="button" class="zoom-btn-plus" data-action="click->image-zoom#zoomIn">+</button>
      </div>
      
      <div class="zoom-dropdown hidden" data-image-zoom-target="zoomDropdown">
        <div class="zoom-option" data-action="click->image-zoom#selectZoomLevel" data-zoom="25">25%</div>
        <div class="zoom-option" data-action="click->image-zoom#selectZoomLevel" data-zoom="50">50%</div>
        <div class="zoom-option active" data-action="click->image-zoom#selectZoomLevel" data-zoom="100">
          100% <span class="zoom-label">Actual size</span>
        </div>
        <div class="zoom-option" data-action="click->image-zoom#selectZoomLevel" data-zoom="125">125%</div>
        <div class="zoom-option" data-action="click->image-zoom#selectZoomLevel" data-zoom="150">150%</div>
        <div class="zoom-option" data-action="click->image-zoom#selectZoomLevel" data-zoom="200">200%</div>
        <div class="zoom-option" data-action="click->image-zoom#selectZoomLevel" data-zoom="300">300%</div>
        <div class="zoom-option" data-action="click->image-zoom#selectZoomLevel" data-zoom="400">400%</div>
        <div class="zoom-option" data-action="click->image-zoom#selectZoomLevel" data-zoom="600">600%</div>
        <div class="zoom-option" data-action="click->image-zoom#selectZoomLevel" data-zoom="800">800%</div>
        <div class="zoom-option" data-action="click->image-zoom#selectZoomLevel" data-zoom="1600">1600%</div>
      </div>
    </div>
    
    <div class="flex items-center gap-2">
      <!-- Undo -->
      <button type="button"
              data-action="click->image-editor#undo"
              data-image-editor-target="undoBtn"
              disabled
              class="p-2 rounded disabled:opacity-50 hover:bg-opacity-80 transition-colors"
              style="background: <%= theme[:secondary_bg] %>; color: <%= theme[:text_color] %>;"
              title="Undo">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 7v6h6"/>
          <path d="M21 17a9 9 0 00-9-9 9 9 0 00-6 2.3L3 13"/>
        </svg>
      </button>
      <!-- Redo -->
      <button type="button"
              data-action="click->image-editor#redo"
              data-image-editor-target="redoBtn"
              disabled
              class="p-2 rounded disabled:opacity-50 hover:bg-opacity-80 transition-colors"
              style="background: <%= theme[:secondary_bg] %>; color: <%= theme[:text_color] %>;"
              title="Redo">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 7v6h-6"/>
          <path d="M3 17a9 9 0 019-9 9 9 0 016 2.3l3 2.7"/>
        </svg>
      </button>
      <!-- Cancel -->
      <button type="button"
              data-action="click->image-editor#cancelEditing"
              class="px-3 py-1.5 rounded text-sm"
              style="background: <%= theme[:secondary_bg] %>; color: <%= theme[:text_color] %>;">
        Cancel
      </button>
      <!-- Save -->
      <button type="button"
              data-action="click->image-editor#saveEdits"
              class="px-4 py-1.5 rounded text-sm font-medium"
              style="background: <%= theme[:button_bg] %>; color: <%= theme[:button_text] %>;">
        Save
      </button>
    </div>
  </div>

  <!-- Main Content -->
  <div class="flex h-[calc(100vh-120px)]">
    
    <!-- Left: Tabs -->
    <div class="w-48 border-r p-4"
         style="border-color: <%= theme[:border_color] %>; background: <%= theme[:bg_color] %>;">
      <div class="space-y-2">
        <button type="button"
                data-action="click->image-editor#switchTab"
                data-tab="filters"
                data-image-editor-target="tabBtn"
                class="w-full text-left px-4 py-2 rounded text-sm font-medium tab-btn-active"
                style="background: <%= theme[:button_bg] %>; color: <%= theme[:button_text] %>;">
          Filters
        </button>
        <button type="button"
                data-action="click->image-editor#switchTab"
                data-tab="crop"
                data-image-editor-target="tabBtn"
                class="w-full text-left px-4 py-2 rounded text-sm"
                style="color: <%= theme[:text_color] %>;">
          Crop
        </button>
        <button type="button"
                data-action="click->image-editor#switchTab"
                data-tab="scale"
                data-image-editor-target="tabBtn"
                class="w-full text-left px-4 py-2 rounded text-sm"
                style="color: <%= theme[:text_color] %>;">
          Scale
        </button>
        <button type="button"
                data-action="click->image-editor#switchTab"
                data-tab="rotation"
                data-image-editor-target="tabBtn"
                class="w-full text-left px-4 py-2 rounded text-sm"
                style="color: <%= theme[:text_color] %>;">
          Rotation
        </button>
        <button type="button"
                data-action="click->image-editor#switchTab"
                data-tab="advanced"
                data-image-editor-target="tabBtn"
                class="w-full text-left px-4 py-2 rounded text-sm"
                style="color: <%= theme[:text_color] %>;">
          Advanced
        </button>
        <button type="button"
                data-action="click->image-editor#switchTab"
                data-tab="meta"
                data-image-editor-target="tabBtn"
                class="w-full text-left px-4 py-2 rounded text-sm"
                style="color: <%= theme[:text_color] %>;">
          Meta
        </button>
      </div>
    </div>

    <!-- Center: Canvas/Preview -->
    <div class="flex-1 flex items-center justify-center p-8 overflow-hidden"
         style="background: <%= theme[:secondary_bg] %>;">
      <!-- Virtual Image Display -->
      <div class="relative max-w-full overflow-hidden canvas-checkerboard-container" style="max-height: calc(100vh - 200px);">
        <div data-image-zoom-target="canvasWrapper" style="transform-origin: 0 0;">
          <canvas data-image-editor-target="virtualCanvas"
                  class="shadow-xl"
                  style="max-width: 100%; max-height: calc(100vh - 200px); display: block; object-fit: contain;"></canvas>
        </div>
      </div>
    </div>

    <!-- Right: Tab Content Panels -->
    <div class="w-80 border-l overflow-y-auto"
         style="border-color: <%= theme[:border_color] %>; background: <%= theme[:bg_color] %>;">
      
      <!-- FILTERS TAB -->
      <div data-image-editor-target="filtersPanel" class="p-6">
        <h3 class="text-sm font-semibold mb-4" style="color: <%= theme[:text_color] %>;">
          Choose Filter
        </h3>
        <div class="mb-3">
          <input type="text" 
                 data-image-editor-target="filterSearch"
                 data-action="input->image-editor#filterFilters"
                 placeholder="Search filters..."
                 class="w-full px-3 py-2 rounded text-sm border"
                 style="background: <%= theme[:input_bg] %>; color: <%= theme[:text_color] %>; border-color: <%= theme[:border_color] %>;">
        </div>
        <div class="grid grid-cols-2 gap-3" data-image-editor-target="filterGrid">
          <!-- Filter thumbnails will be dynamically generated -->
        </div>
        
        <!-- Dry/Wet Popover -->
        <div data-image-editor-target="filterPopover" class="hidden absolute z-50 p-4 rounded shadow-lg"
             style="background: <%= theme[:secondary_bg] %>; border: 1px solid <%= theme[:border_color] %>; min-width: 200px;">
          <!-- Caret Pointer - Centered -->
          <div class="absolute -bottom-2 left-1/2 -translate-x-1/2 w-4 h-4 rotate-45" 
               style="background: <%= theme[:secondary_bg] %>; border-right: 1px solid <%= theme[:border_color] %>; border-bottom: 1px solid <%= theme[:border_color] %>;"></div>
          
          <!-- Title -->
          <div class="text-xs font-semibold mb-3 text-center" data-image-editor-target="popoverFilterName" style="color: <%= theme[:text_color] %>;"></div>
          
          <!-- Slider -->
          <input type="range" min="0" max="100" value="100"
                 data-action="input->image-editor#updateDryWet"
                 data-image-editor-target="dryWetSlider"
                 class="w-full mb-2 filter-intensity-slider">
          
          <!-- Percentage -->
          <div class="text-xs text-center font-semibold" data-image-editor-target="dryWetValue" style="color: <%= theme[:text_color] %>;">100%</div>
        </div>
      </div>

      <!-- CROP TAB -->
      <div data-image-editor-target="cropPanel" class="p-6 hidden">
        <h3 class="text-sm font-semibold mb-4" style="color: <%= theme[:text_color] %>;">
          Crop Image
        </h3>
        <div class="space-y-4">
          <div>
            <label class="block text-xs mb-2" style="color: <%= theme[:text_color] %>;">
              Aspect Ratio
            </label>
            <select data-image-editor-target="aspectRatio"
                    data-action="change->image-editor#changeAspectRatio"
                    class="w-full px-3 py-2 rounded text-sm"
                    style="background: <%= theme[:input_bg] %>; color: <%= theme[:text_color] %>; border: 1px solid <%= theme[:border_color] %>;">
              <option value="free">Free</option>
              <option value="1">1:1 (Square)</option>
              <option value="1.3333333333333333">4:3</option>
              <option value="1.7777777777777777">16:9</option>
              <option value="0.75">3:4 (Portrait)</option>
              <option value="0.5625">9:16 (Story)</option>
            </select>
          </div>
          <button type="button"
                  data-action="click->image-editor#applyCrop"
                  class="w-full px-4 py-2 rounded text-sm font-medium"
                  style="background: <%= theme[:button_bg] %>; color: <%= theme[:button_text] %>;">
            Apply Crop
          </button>
        </div>
      </div>

      <!-- SCALE TAB -->
      <div data-image-editor-target="scalePanel" class="p-6 hidden">
        <h3 class="text-sm font-semibold mb-4" style="color: <%= theme[:text_color] %>;">
          Scale Image
        </h3>
        <div class="space-y-4">
          <div>
            <label class="block text-xs mb-2" style="color: <%= theme[:text_color] %>;">
              Width
            </label>
            <input type="number"
                   data-image-editor-target="scaleWidth"
                   data-action="input->image-editor#updateScaleHeight"
                   class="w-full px-3 py-2 rounded text-sm"
                   style="background: <%= theme[:input_bg] %>; color: <%= theme[:text_color] %>; border: 1px solid <%= theme[:border_color] %>;">
          </div>
          <div>
            <label class="block text-xs mb-2" style="color: <%= theme[:text_color] %>;">
              Height
            </label>
            <input type="number"
                   data-image-editor-target="scaleHeight"
                   data-action="input->image-editor#updateScaleWidth"
                   class="w-full px-3 py-2 rounded text-sm"
                   style="background: <%= theme[:input_bg] %>; color: <%= theme[:text_color] %>; border: 1px solid <%= theme[:border_color] %>;">
          </div>
          <label class="flex items-center gap-2">
            <input type="checkbox"
                   data-image-editor-target="lockAspect"
                   checked
                   class="rounded">
            <span class="text-xs" style="color: <%= theme[:text_color] %>;">
              Lock aspect ratio
            </span>
          </label>
          <button type="button"
                  data-action="click->image-editor#applyScale"
                  class="w-full px-4 py-2 rounded text-sm font-medium"
                  style="background: <%= theme[:button_bg] %>; color: <%= theme[:button_text] %>;">
            Apply Scale
          </button>
        </div>
      </div>

      <!-- ROTATION TAB -->
      <div data-image-editor-target="rotationPanel" class="p-6 hidden">
        <h3 class="text-sm font-semibold mb-4" style="color: <%= theme[:text_color] %>;">
          Rotate & Flip
        </h3>
        <div class="space-y-3">
          <button type="button"
                  data-action="click->image-editor#rotateLeft"
                  class="w-full px-4 py-2 rounded text-sm"
                  style="background: <%= theme[:secondary_bg] %>; color: <%= theme[:text_color] %>; border: 1px solid <%= theme[:border_color] %>;">
            Rotate 90° Left
          </button>
          <button type="button"
                  data-action="click->image-editor#rotateRight"
                  class="w-full px-4 py-2 rounded text-sm"
                  style="background: <%= theme[:secondary_bg] %>; color: <%= theme[:text_color] %>; border: 1px solid <%= theme[:border_color] %>;">
            Rotate 90° Right
          </button>
          <button type="button"
                  data-action="click->image-editor#rotate180"
                  class="w-full px-4 py-2 rounded text-sm"
                  style="background: <%= theme[:secondary_bg] %>; color: <%= theme[:text_color] %>; border: 1px solid <%= theme[:border_color] %>;">
            Rotate 180°
          </button>
          <button type="button"
                  data-action="click->image-editor#flipHorizontal"
                  class="w-full px-4 py-2 rounded text-sm"
                  style="background: <%= theme[:secondary_bg] %>; color: <%= theme[:text_color] %>; border: 1px solid <%= theme[:border_color] %>;">
            Flip Horizontal
          </button>
          <button type="button"
                  data-action="click->image-editor#flipVertical"
                  class="w-full px-4 py-2 rounded text-sm"
                  style="background: <%= theme[:secondary_bg] %>; color: <%= theme[:text_color] %>; border: 1px solid <%= theme[:border_color] %>; %>;">
            Flip Vertical
          </button>
        </div>
      </div>

      <!-- ADVANCED TAB -->
      <div data-image-editor-target="advancedPanel" class="p-6 hidden">
        <h3 class="text-sm font-semibold mb-4" style="color: <%= theme[:text_color] %>;">
          Advanced Adjustments
        </h3>

        <!-- LIGHT SECTION -->
        <div class="image-editor-slider-group mb-4" data-category="light">
          <div class="image-editor-slider-group-header" 
               data-action="click->image-editor#toggleCategory"
               data-category="light"
               style="background: <%= theme[:secondary_bg] %>; border: 1px solid <%= theme[:border_color] %>; cursor: pointer; padding: 0.75rem 1rem; display: flex; justify-content: space-between; align-items: center; border-radius: 6px; margin-bottom: 1rem;">
            <span class="text-sm font-medium" style="color: <%= theme[:text_color] %>;">Light</span>
            <svg class="chevron-icon w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: <%= theme[:text_color] %>; transition: transform 0.2s;">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </div>
          <div class="image-editor-slider-content" data-category-content="light" hidden style="padding: 0 0.5rem; box-sizing: border-box; width: 100%;">
            <!-- Exposure -->
            <div class="image-editor-slider-item">
              <label class="image-editor-slider-label">
                <span class="image-editor-slider-name" style="color: <%= theme[:text_color] %>;">Exposure</span>
                <span class="image-editor-slider-value" data-image-editor-target="exposureValue" style="color: <%= theme[:text_color] %>;">0</span>
              </label>
              <input type="range" 
                     data-image-editor-target="exposureSlider"
                     data-action="input->image-editor#updateAdvanced"
                     min="-100" max="100" value="0"
                     class="image-editor-slider">
            </div>
            <!-- Brightness -->
            <div class="image-editor-slider-item">
              <label class="image-editor-slider-label">
                <span class="image-editor-slider-name" style="color: <%= theme[:text_color] %>;">Brightness</span>
                <span class="image-editor-slider-value" data-image-editor-target="brightnessValue" style="color: <%= theme[:text_color] %>;">100%</span>
              </label>
              <input type="range" 
                     data-image-editor-target="brightnessSlider"
                     data-action="input->image-editor#updateAdvanced"
                     min="0" max="200" value="100"
                     class="image-editor-slider">
            </div>
            <!-- Contrast -->
            <div class="image-editor-slider-item">
              <label class="image-editor-slider-label">
                <span class="image-editor-slider-name" style="color: <%= theme[:text_color] %>;">Contrast</span>
                <span class="image-editor-slider-value" data-image-editor-target="contrastValue" style="color: <%= theme[:text_color] %>;">100%</span>
              </label>
              <input type="range" 
                     data-image-editor-target="contrastSlider"
                     data-action="input->image-editor#updateAdvanced"
                     min="0" max="200" value="100"
                     class="image-editor-slider">
            </div>
            <!-- Highlights -->
            <div class="image-editor-slider-item">
              <label class="image-editor-slider-label">
                <span class="image-editor-slider-name" style="color: <%= theme[:text_color] %>;">Highlights</span>
                <span class="image-editor-slider-value" data-image-editor-target="highlightsValue" style="color: <%= theme[:text_color] %>;">100%</span>
              </label>
              <input type="range" 
                     data-image-editor-target="highlightsSlider"
                     data-action="input->image-editor#updateAdvanced"
                     min="0" max="200" value="100"
                     class="image-editor-slider">
            </div>
            <!-- Shadows -->
            <div class="image-editor-slider-item">
              <label class="image-editor-slider-label">
                <span class="image-editor-slider-name" style="color: <%= theme[:text_color] %>;">Shadows</span>
                <span class="image-editor-slider-value" data-image-editor-target="shadowsValue" style="color: <%= theme[:text_color] %>;">100%</span>
              </label>
              <input type="range" 
                     data-image-editor-target="shadowsSlider"
                     data-action="input->image-editor#updateAdvanced"
                     min="0" max="200" value="100"
                     class="image-editor-slider">
            </div>
            <!-- Whites -->
            <div class="image-editor-slider-item">
              <label class="image-editor-slider-label">
                <span class="image-editor-slider-name" style="color: <%= theme[:text_color] %>;">Whites</span>
                <span class="image-editor-slider-value" data-image-editor-target="whitesValue" style="color: <%= theme[:text_color] %>;">50%</span>
              </label>
              <input type="range" 
                     data-image-editor-target="whitesSlider"
                     data-action="input->image-editor#updateAdvanced"
                     min="0" max="100" value="50"
                     class="image-editor-slider">
            </div>
            <!-- Blacks -->
            <div class="image-editor-slider-item">
              <label class="image-editor-slider-label">
                <span class="image-editor-slider-name" style="color: <%= theme[:text_color] %>;">Blacks</span>
                <span class="image-editor-slider-value" data-image-editor-target="blacksValue" style="color: <%= theme[:text_color] %>;">50%</span>
              </label>
              <input type="range" 
                     data-image-editor-target="blacksSlider"
                     data-action="input->image-editor#updateAdvanced"
                     min="0" max="100" value="50"
                     class="image-editor-slider">
            </div>
          </div>
        </div>

        <!-- COLOR SECTION -->
        <div class="image-editor-slider-group mb-4" data-category="color">
          <div class="image-editor-slider-group-header" 
               data-action="click->image-editor#toggleCategory"
               data-category="color"
               style="background: <%= theme[:secondary_bg] %>; border: 1px solid <%= theme[:border_color] %>; cursor: pointer; padding: 0.75rem 1rem; display: flex; justify-content: space-between; align-items: center; border-radius: 6px; margin-bottom: 1rem;">
            <span class="text-sm font-medium" style="color: <%= theme[:text_color] %>;">Color</span>
            <svg class="chevron-icon w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: <%= theme[:text_color] %>; transition: transform 0.2s;">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </div>
          <div class="image-editor-slider-content" data-category-content="color" hidden style="padding: 0 0.5rem; box-sizing: border-box; width: 100%;">
            <!-- Temperature -->
            <div class="image-editor-slider-item">
              <label class="image-editor-slider-label">
                <span class="image-editor-slider-name" style="color: <%= theme[:text_color] %>;">Temperature</span>
                <span class="image-editor-slider-value" data-image-editor-target="temperatureValue" style="color: <%= theme[:text_color] %>;">0</span>
              </label>
              <input type="range" 
                     data-image-editor-target="temperatureSlider"
                     data-action="input->image-editor#updateAdvanced"
                     min="-100" max="100" value="0"
                     class="image-editor-slider">
            </div>
            <!-- Tint -->
            <div class="image-editor-slider-item">
              <label class="image-editor-slider-label">
                <span class="image-editor-slider-name" style="color: <%= theme[:text_color] %>;">Tint</span>
                <span class="image-editor-slider-value" data-image-editor-target="tintValue" style="color: <%= theme[:text_color] %>;">0</span>
              </label>
              <input type="range" 
                     data-image-editor-target="tintSlider"
                     data-action="input->image-editor#updateAdvanced"
                     min="-100" max="100" value="0"
                     class="image-editor-slider">
            </div>
            <!-- Saturation -->
            <div class="image-editor-slider-item">
              <label class="image-editor-slider-label">
                <span class="image-editor-slider-name" style="color: <%= theme[:text_color] %>;">Saturation</span>
                <span class="image-editor-slider-value" data-image-editor-target="saturationValue" style="color: <%= theme[:text_color] %>;">100%</span>
              </label>
              <input type="range" 
                     data-image-editor-target="saturationSlider"
                     data-action="input->image-editor#updateAdvanced"
                     min="0" max="200" value="100"
                     class="image-editor-slider">
            </div>
            <!-- Hue -->
            <div class="image-editor-slider-item">
              <label class="image-editor-slider-label">
                <span class="image-editor-slider-name" style="color: <%= theme[:text_color] %>;">Hue</span>
                <span class="image-editor-slider-value" data-image-editor-target="hueValue" style="color: <%= theme[:text_color] %>;">0°</span>
              </label>
              <input type="range" 
                     data-image-editor-target="hueSlider"
                     data-action="input->image-editor#updateAdvanced"
                     min="-180" max="180" value="0"
                     class="image-editor-slider">
            </div>
            <!-- Vibrance -->
            <div class="image-editor-slider-item">
              <label class="image-editor-slider-label">
                <span class="image-editor-slider-name" style="color: <%= theme[:text_color] %>;">Vibrance</span>
                <span class="image-editor-slider-value" data-image-editor-target="vibranceValue" style="color: <%= theme[:text_color] %>;">0</span>
              </label>
              <input type="range" 
                     data-image-editor-target="vibranceSlider"
                     data-action="input->image-editor#updateAdvanced"
                     min="-100" max="100" value="0"
                     class="image-editor-slider">
            </div>
          </div>
        </div>

        <!-- EFFECTS SECTION -->
        <div class="image-editor-slider-group mb-4" data-category="effects">
          <div class="image-editor-slider-group-header" 
               data-action="click->image-editor#toggleCategory"
               data-category="effects"
               style="background: <%= theme[:secondary_bg] %>; border: 1px solid <%= theme[:border_color] %>; cursor: pointer; padding: 0.75rem 1rem; display: flex; justify-content: space-between; align-items: center; border-radius: 6px; margin-bottom: 1rem;">
            <span class="text-sm font-medium" style="color: <%= theme[:text_color] %>;">Effects</span>
            <svg class="chevron-icon w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: <%= theme[:text_color] %>; transition: transform 0.2s;">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </div>
          <div class="image-editor-slider-content" data-category-content="effects" hidden style="padding: 0 0.5rem; box-sizing: border-box; width: 100%;">
            <!-- Blur -->
            <div class="image-editor-slider-item">
              <label class="image-editor-slider-label">
                <span class="image-editor-slider-name" style="color: <%= theme[:text_color] %>;">Blur</span>
                <span class="image-editor-slider-value" data-image-editor-target="blurValue" style="color: <%= theme[:text_color] %>;">0px</span>
              </label>
              <input type="range" 
                     data-image-editor-target="blurSlider"
                     data-action="input->image-editor#updateAdvanced"
                     min="0" max="10" value="0"
                     class="image-editor-slider">
            </div>
            <!-- Sharpen -->
            <div class="image-editor-slider-item">
              <label class="image-editor-slider-label">
                <span class="image-editor-slider-name" style="color: <%= theme[:text_color] %>;">Sharpen</span>
                <span class="image-editor-slider-value" data-image-editor-target="sharpenValue" style="color: <%= theme[:text_color] %>;">0</span>
              </label>
              <input type="range" 
                     data-image-editor-target="sharpenSlider"
                     data-action="input->image-editor#updateAdvanced"
                     min="0" max="100" value="0"
                     class="image-editor-slider">
            </div>
            <!-- Vignette -->
            <div class="image-editor-slider-item">
              <label class="image-editor-slider-label">
                <span class="image-editor-slider-name" style="color: <%= theme[:text_color] %>;">Vignette</span>
                <span class="image-editor-slider-value" data-image-editor-target="vignetteValue" style="color: <%= theme[:text_color] %>;">0%</span>
              </label>
              <input type="range" 
                     data-image-editor-target="vignetteSlider"
                     data-action="input->image-editor#updateAdvanced"
                     min="0" max="100" value="0"
                     class="image-editor-slider">
            </div>
          </div>
        </div>

        <!-- DETAIL SECTION -->
        <div class="image-editor-slider-group mb-4" data-category="detail">
          <div class="image-editor-slider-group-header" 
               data-action="click->image-editor#toggleCategory"
               data-category="detail"
               style="background: <%= theme[:secondary_bg] %>; border: 1px solid <%= theme[:border_color] %>; cursor: pointer; padding: 0.75rem 1rem; display: flex; justify-content: space-between; align-items: center; border-radius: 6px; margin-bottom: 1rem;">
            <span class="text-sm font-medium" style="color: <%= theme[:text_color] %>;">Detail</span>
            <svg class="chevron-icon w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: <%= theme[:text_color] %>; transition: transform 0.2s;">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </div>
          <div class="image-editor-slider-content" data-category-content="detail" hidden style="padding: 0 0.5rem; box-sizing: border-box; width: 100%;">
            <!-- Sharpening Group -->
            <div class="mb-4">
              <!-- Sharpening -->
              <div class="image-editor-slider-item">
                <label class="image-editor-slider-label">
                  <span class="image-editor-slider-name" style="color: <%= theme[:text_color] %>;">Sharpening</span>
                  <span class="image-editor-slider-value" data-image-editor-target="sharpeningValue" style="color: <%= theme[:text_color] %>;">0</span>
                </label>
                <input type="range" 
                       data-image-editor-target="sharpeningSlider"
                       data-action="input->image-editor#updateAdvanced"
                       min="0" max="100" value="0"
                       class="image-editor-slider">
              </div>
              <!-- Radius -->
              <div class="image-editor-slider-item">
                <label class="image-editor-slider-label">
                  <span class="image-editor-slider-name" style="color: <%= theme[:text_color] %>; opacity: 0.6;">Radius</span>
                  <span class="image-editor-slider-value" data-image-editor-target="radiusValue" style="color: <%= theme[:text_color] %>; opacity: 0.6;">1.0</span>
                </label>
                <input type="range" 
                       data-image-editor-target="radiusSlider"
                       data-action="input->image-editor#updateAdvanced"
                       min="0" max="100" value="50"
                       class="image-editor-slider"
                       disabled>
              </div>
              <!-- Detail (Sharpening) -->
              <div class="image-editor-slider-item">
                <label class="image-editor-slider-label">
                  <span class="image-editor-slider-name" style="color: <%= theme[:text_color] %>; opacity: 0.6;">Detail</span>
                  <span class="image-editor-slider-value" data-image-editor-target="sharpeningDetailValue" style="color: <%= theme[:text_color] %>; opacity: 0.6;">50</span>
                </label>
                <input type="range" 
                       data-image-editor-target="sharpeningDetailSlider"
                       data-action="input->image-editor#updateAdvanced"
                       min="0" max="100" value="50"
                       class="image-editor-slider"
                       disabled>
              </div>
              <!-- Masking -->
              <div class="image-editor-slider-item">
                <label class="image-editor-slider-label">
                  <span class="image-editor-slider-name" style="color: <%= theme[:text_color] %>; opacity: 0.6;">Masking</span>
                  <span class="image-editor-slider-value" data-image-editor-target="maskingValue" style="color: <%= theme[:text_color] %>; opacity: 0.6;">0</span>
                </label>
                <input type="range" 
                       data-image-editor-target="maskingSlider"
                       data-action="input->image-editor#updateAdvanced"
                       min="0" max="100" value="0"
                       class="image-editor-slider"
                       disabled>
              </div>
            </div>

            <!-- Separator -->
            <div class="my-4" style="border-top: 1px solid <%= theme[:border_color] %>; opacity: 0.5;"></div>

            <!-- Noise Reduction Group -->
            <div class="mb-4">
              <!-- Noise Reduction -->
              <div class="image-editor-slider-item">
                <label class="image-editor-slider-label">
                  <span class="image-editor-slider-name" style="color: <%= theme[:text_color] %>;">Noise Reduction</span>
                  <span class="image-editor-slider-value" data-image-editor-target="noiseReductionValue" style="color: <%= theme[:text_color] %>;">0</span>
                </label>
                <input type="range" 
                       data-image-editor-target="noiseReductionSlider"
                       data-action="input->image-editor#updateAdvanced"
                       min="0" max="100" value="0"
                       class="image-editor-slider">
              </div>
              <!-- Detail (Noise Reduction) -->
              <div class="image-editor-slider-item">
                <label class="image-editor-slider-label">
                  <span class="image-editor-slider-name" style="color: <%= theme[:text_color] %>; opacity: 0.6;">Detail</span>
                  <span class="image-editor-slider-value" data-image-editor-target="noiseDetailValue" style="color: <%= theme[:text_color] %>; opacity: 0.6;">50</span>
                </label>
                <input type="range" 
                       data-image-editor-target="noiseDetailSlider"
                       data-action="input->image-editor#updateAdvanced"
                       min="0" max="100" value="50"
                       class="image-editor-slider"
                       disabled>
              </div>
              <!-- Contrast (Noise Reduction) -->
              <div class="image-editor-slider-item">
                <label class="image-editor-slider-label">
                  <span class="image-editor-slider-name" style="color: <%= theme[:text_color] %>; opacity: 0.6;">Contrast</span>
                  <span class="image-editor-slider-value" data-image-editor-target="noiseContrastValue" style="color: <%= theme[:text_color] %>; opacity: 0.6;">50</span>
                </label>
                <input type="range" 
                       data-image-editor-target="noiseContrastSlider"
                       data-action="input->image-editor#updateAdvanced"
                       min="0" max="100" value="50"
                       class="image-editor-slider"
                       disabled>
              </div>
            </div>

            <!-- Separator -->
            <div class="my-4" style="border-top: 1px solid <%= theme[:border_color] %>; opacity: 0.5;"></div>

            <!-- Color Noise Reduction Group -->
            <div class="mb-4">
              <!-- Color Noise Reduction -->
              <div class="image-editor-slider-item">
                <label class="image-editor-slider-label">
                  <span class="image-editor-slider-name" style="color: <%= theme[:text_color] %>;">Color Noise Reduction</span>
                  <span class="image-editor-slider-value" data-image-editor-target="colorNoiseReductionValue" style="color: <%= theme[:text_color] %>;">0</span>
                </label>
                <input type="range" 
                       data-image-editor-target="colorNoiseReductionSlider"
                       data-action="input->image-editor#updateAdvanced"
                       min="0" max="100" value="0"
                       class="image-editor-slider">
              </div>
              <!-- Detail (Color Noise) -->
              <div class="image-editor-slider-item">
                <label class="image-editor-slider-label">
                  <span class="image-editor-slider-name" style="color: <%= theme[:text_color] %>; opacity: 0.6;">Detail</span>
                  <span class="image-editor-slider-value" data-image-editor-target="colorNoiseDetailValue" style="color: <%= theme[:text_color] %>; opacity: 0.6;">50</span>
                </label>
                <input type="range" 
                       data-image-editor-target="colorNoiseDetailSlider"
                       data-action="input->image-editor#updateAdvanced"
                       min="0" max="100" value="50"
                       class="image-editor-slider"
                       disabled>
              </div>
              <!-- Smoothness -->
              <div class="image-editor-slider-item">
                <label class="image-editor-slider-label">
                  <span class="image-editor-slider-name" style="color: <%= theme[:text_color] %>; opacity: 0.6;">Smoothness</span>
                  <span class="image-editor-slider-value" data-image-editor-target="smoothnessValue" style="color: <%= theme[:text_color] %>; opacity: 0.6;">50</span>
                </label>
                <input type="range" 
                       data-image-editor-target="smoothnessSlider"
                       data-action="input->image-editor#updateAdvanced"
                       min="0" max="100" value="50"
                       class="image-editor-slider"
                       disabled>
              </div>
            </div>
          </div>
        </div>

        <button type="button"
                data-action="click->image-editor#resetAdvanced"
                class="w-full px-4 py-2 rounded text-sm font-medium"
                style="background: <%= theme[:secondary_bg] %>; color: <%= theme[:text_color] %>; border: 1px solid <%= theme[:border_color] %>;">
          Reset All
        </button>
    </div>

      <!-- Meta Panel -->
      <div data-image-editor-target="metaPanel" class="p-6 hidden">
        <h3 class="text-sm font-semibold mb-4" style="color: <%= theme[:text_color] %>;">
          EXIF Metadata
        </h3>
        
        <!-- Loading state -->
        <div data-image-editor-target="metaLoading" class="text-center py-8">
          <p class="text-sm" style="color: <%= theme[:text_color] %>;">Loading metadata...</p>
        </div>
        
        <!-- No metadata state -->
        <div data-image-editor-target="metaEmpty" class="hidden text-center py-8">
          <p class="text-sm" style="color: <%= theme[:text_color] %>;">No EXIF data found</p>
        </div>
        
        <!-- Metadata content -->
        <div data-image-editor-target="metaContent" class="hidden">
          <div class="space-y-4">
          <!-- Camera Information -->
          <div class="metadata-section">
            <h4 class="text-xs font-semibold mb-2 uppercase" style="color: <%= theme[:text_color] %>;">Camera</h4>
            <div class="metadata-field">
              <label class="block text-xs mb-2" style="color: <%= theme[:text_color] %>;">Make</label>
              <input type="text" data-exif-field="Make" class="w-full px-3 py-2 rounded text-sm" 
                     style="background: <%= theme[:input_bg] %>; color: <%= theme[:text_color] %>; border: 1px solid <%= theme[:border_color] %>;">
            </div>
            <div class="metadata-field">
              <label class="block text-xs mb-2" style="color: <%= theme[:text_color] %>;">Model</label>
              <input type="text" data-exif-field="Model" class="w-full px-3 py-2 rounded text-sm" 
                     style="background: <%= theme[:input_bg] %>; color: <%= theme[:text_color] %>; border: 1px solid <%= theme[:border_color] %>;">
            </div>
            <div class="metadata-field">
              <label class="block text-xs mb-2" style="color: <%= theme[:text_color] %>;">Lens Model</label>
              <input type="text" data-exif-field="LensModel" class="w-full px-3 py-2 rounded text-sm" 
                     style="background: <%= theme[:input_bg] %>; color: <%= theme[:text_color] %>; border: 1px solid <%= theme[:border_color] %>;">
            </div>
          </div>
          
          <!-- Exposure Settings -->
          <div class="metadata-section">
            <h4 class="text-xs font-semibold mb-2 uppercase" style="color: <%= theme[:text_color] %>;">Exposure</h4>
            <div class="metadata-field">
              <label class="block text-xs mb-2" style="color: <%= theme[:text_color] %>;">ISO</label>
              <input type="text" data-exif-field="ISOSpeedRatings" class="w-full px-3 py-2 rounded text-sm" 
                     style="background: <%= theme[:input_bg] %>; color: <%= theme[:text_color] %>; border: 1px solid <%= theme[:border_color] %>;">
            </div>
            <div class="metadata-field">
              <label class="block text-xs mb-2" style="color: <%= theme[:text_color] %>;">Aperture</label>
              <input type="text" data-exif-field="FNumber" class="w-full px-3 py-2 rounded text-sm" 
                     style="background: <%= theme[:input_bg] %>; color: <%= theme[:text_color] %>; border: 1px solid <%= theme[:border_color] %>;">
            </div>
            <div class="metadata-field">
              <label class="block text-xs mb-2" style="color: <%= theme[:text_color] %>;">Shutter Speed</label>
              <input type="text" data-exif-field="ExposureTime" class="w-full px-3 py-2 rounded text-sm" 
                     style="background: <%= theme[:input_bg] %>; color: <%= theme[:text_color] %>; border: 1px solid <%= theme[:border_color] %>;">
            </div>
            <div class="metadata-field">
              <label class="block text-xs mb-2" style="color: <%= theme[:text_color] %>;">Focal Length</label>
              <input type="text" data-exif-field="FocalLength" class="w-full px-3 py-2 rounded text-sm" 
                     style="background: <%= theme[:input_bg] %>; color: <%= theme[:text_color] %>; border: 1px solid <%= theme[:border_color] %>;">
            </div>
          </div>
          
          <!-- GPS -->
          <div class="metadata-section">
            <h4 class="text-xs font-semibold mb-2 uppercase" style="color: <%= theme[:text_color] %>;">Location (GPS)</h4>
            <div class="metadata-field">
              <label class="block text-xs mb-2" style="color: <%= theme[:text_color] %>;">Latitude</label>
              <input type="text" data-exif-field="GPSLatitude" class="w-full px-3 py-2 rounded text-sm" 
                     style="background: <%= theme[:input_bg] %>; color: <%= theme[:text_color] %>; border: 1px solid <%= theme[:border_color] %>;">
            </div>
            <div class="metadata-field">
              <label class="block text-xs mb-2" style="color: <%= theme[:text_color] %>;">Longitude</label>
              <input type="text" data-exif-field="GPSLongitude" class="w-full px-3 py-2 rounded text-sm" 
                     style="background: <%= theme[:input_bg] %>; color: <%= theme[:text_color] %>; border: 1px solid <%= theme[:border_color] %>;">
            </div>
          </div>
          
          <!-- Image Info -->
          <div class="metadata-section">
            <h4 class="text-xs font-semibold mb-2 uppercase" style="color: <%= theme[:text_color] %>;">Image Info</h4>
            <div class="metadata-field">
              <label class="block text-xs mb-2" style="color: <%= theme[:text_color] %>;">Copyright</label>
              <input type="text" data-exif-field="Copyright" class="w-full px-3 py-2 rounded text-sm" 
                     style="background: <%= theme[:input_bg] %>; color: <%= theme[:text_color] %>; border: 1px solid <%= theme[:border_color] %>;">
            </div>
            <div class="metadata-field">
              <label class="block text-xs mb-2" style="color: <%= theme[:text_color] %>;">Artist</label>
              <input type="text" data-exif-field="Artist" class="w-full px-3 py-2 rounded text-sm" 
                     style="background: <%= theme[:input_bg] %>; color: <%= theme[:text_color] %>; border: 1px solid <%= theme[:border_color] %>;">
            </div>
            <div class="metadata-field">
              <label class="block text-xs mb-2" style="color: <%= theme[:text_color] %>;">Software</label>
              <input type="text" data-exif-field="Software" class="w-full px-3 py-2 rounded text-sm" 
                     style="background: <%= theme[:input_bg] %>; color: <%= theme[:text_color] %>; border: 1px solid <%= theme[:border_color] %>;">
            </div>
            <div class="metadata-field">
              <label class="block text-xs mb-2" style="color: <%= theme[:text_color] %>;">Date Taken</label>
              <input type="text" data-exif-field="DateTime" class="w-full px-3 py-2 rounded text-sm" 
                     style="background: <%= theme[:input_bg] %>; color: <%= theme[:text_color] %>; border: 1px solid <%= theme[:border_color] %>;">
            </div>
          </div>
          
            <div class="mt-6">
              <a href="#"
                 data-action="click->image-editor#clearAllMetadata"
                 class="block text-sm"
                 style="color: var(--admin-error);">
                Clear All Metadata
              </a>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>
