{
  "name": "Post Content",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_sidebar",
      "label": "Show Sidebar",
      "default": true
    },
    {
      "type": "select",
      "id": "sidebar_position",
      "label": "Sidebar Position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    },
    {
      "type": "checkbox",
      "id": "show_author_bio",
      "label": "Show Author Bio",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_table_of_contents",
      "label": "Show Table of Contents",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_reading_time",
      "label": "Show Reading Time",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_social_sharing",
      "label": "Show Social Sharing",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_comments",
      "label": "Show Comments",
      "default": true
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content Width",
      "options": [
        { "value": "800", "label": "Standard" },
        { "value": "1200", "label": "Wide" },
        { "value": "100%", "label": "Full Width" }
      ],
      "default": "800"
    }
  ]
}

